# Azyksowda backend konfigurasiýasy
PORT=8080
APP_ENV=development
JWT_SECRET=change-me-in-production-very-long-secret
JWT_EXPIRE_HOURS=168

# sqlite (default) ýa-da postgres
DB_DRIVER=sqlite
# sqlite üçin faýl ýoly / postgres üçin DSN
DATABASE_URL=./data/azyksowda.db
# DATABASE_URL=postgres://user:pass@localhost:5432/azyksowda?sslmode=disable

UPLOAD_DIR=./uploads
LOG_DIR=./logs
FRONTEND_URL=http://localhost:3000

DELIVERY_FEE=10
FREE_DELIVERY_FROM=200

# Ilkinji işe girizilende test maglumatlaryny goşmak
SEED=true
ADMIN_EMAIL=admin@azyksowda.com
ADMIN_PASSWORD=admin123
